# DB (Railway Postgres en prod; local docker en dev)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/spitwise
# FX
FRANKFURTER_URL=https://api.frankfurter.dev/v1
DOLARAPI_URL=https://dolarapi.com/v1
# Dominio público del frontend, para que el bot pueda pasar el link de la app.
# Vacío => el bot omite el link. ej: https://spitwise.lat
SPITWISE_URL=
ENVIRONMENT=dev

# Auth (OBLIGATORIO en prod — sin defaults seguros)
SECRET_KEY=change-me-in-production-use-a-long-random-string
AUTH_USERS=bruno:pass:54911111111,katia:pass:54922222222
JWT_EXPIRE_DAYS=90
CORS_ORIGINS=http://localhost:5173

# Andiamo
TRIP_SHARED_API_KEY=change-me-shared-key
# URL productiva: https://andiamo.lat
ANDIAMO_URL=

# Stop local "Pititas" (4-11 sept 2026): username dueño de esa parada. Sus
# gastos de ese tramo se imputan a Pititas en vez de Portugal. Vacío => la
# parada no se siembra y el itinerario funciona como siempre.
PITITAS_OWNER=katia

# LLM (al menos una key)
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_CHAT_MODEL=gpt-5-mini
# Canal documentos (adjuntos WPP → Andiamo): siempre OpenAI vision.
OPENAI_VISION_MODEL=gpt-5

# WhatsApp Cloud
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0
